PORT=3003

JWT_SECRET=saev-dev-secret-key-change-in-production
JWT_SECONDS_EXPIRE=28800

DB_LOGGING=true
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=app
DB_NAME=saev
DB_SYNC=true
DB_PORT=3306

# Database Replication Configuration
# Set to 'true' to enable read/write splitting (reads go to replica, writes go to master)
DB_REPLICATION_ENABLED=false

# Master (write) database - uses DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD as fallback
DB_MASTER_HOST=localhost
DB_MASTER_PORT=3306
DB_MASTER_USERNAME=saev_user
DB_MASTER_PASSWORD=saev_password

# Replica (read) database
DB_REPLICA_HOST=localhost
DB_REPLICA_PORT=3307
DB_REPLICA_USERNAME=saev_user
DB_REPLICA_PASSWORD=saev_password


HTTP_BASIC_USER_HERBY=
HTTP_BASIC_PASS_HERBY=

MAIL_HOST=
MAIL_PORT=
MAIL_SERVICE=
MAIL_USER=
MAIL_PASS=
MAIL_REPLY=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_WEBHOOK_VERIFICATION_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# WhatsApp Templates (Meta API Compliance)
# Template de opt-in: usado para solicitar permissão antes de enviar mensagens
# Exemplo: "Olá! A escola {{1}} tem uma nova mensagem para você sobre {{2}}. Responda SIM para receber."
TWILIO_OPT_IN_TEMPLATE_SID=

# Template legado (DEPRECATED - não usar para novas mensagens)
TWILIO_MESSAGING_CONTENT_SID=

FRONT_APP_URL=http://localhost:3000
HOST_APP_URL=http://localhost:3003

# Firebase Admin SDK (Push Notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OpenAI Configuration (for AI Analysis)
OPENAI_API_KEY=

# ─── Reprocess (gabarito retroativo) ───
# APP_ROLE: 'primary' = backend principal (Cloud Run com 25 réplicas)
#           'worker'  = serviço dedicado a jobs (carrega WorkerHttpModule)
APP_ROLE=worker

# REPROCESS_DISPATCHER: 'in-process' (dev local) | 'cloud-tasks' (staging/prod)
REPROCESS_DISPATCHER=in-process

# Cloud Tasks (apenas quando REPROCESS_DISPATCHER=cloud-tasks)
GCP_PROJECT_ID=
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_REPROCESS_DEBOUNCE_QUEUE=reprocess-debounce
CLOUD_TASKS_REPROCESS_EXECUTE_QUEUE=reprocess-execute
# Fila de execução das Operações em Lote (desativação de alunos/turmas)
CLOUD_TASKS_BATCH_EXECUTE_QUEUE=batch-execute
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=
CLOUD_TASKS_DEBOUNCE_SECONDS=60

# URL base do Cloud Run worker (alvo das tasks)
WORKER_BASE_URL=http://localhost:3003/v1

# OIDC: lista de service accounts permitidas a chamar /internal/* (Cloud Tasks, Cloud Scheduler).
# Aceita CSV. Ex.: cloud-tasks-invoker@p.iam.gserviceaccount.com,cloud-scheduler-invoker@p.iam.gserviceaccount.com
INTERNAL_OIDC_ALLOWED_EMAILS=

# Destinatários do email de falha de reprocesso (CSV)
REPROCESS_FAILURE_NOTIFICATION_EMAIL=

# Bypass do OIDC guard em dev local. Requer:
#  - ALLOW_LOCAL_BYPASS=true (opt-in explícito)
#  - NODE_ENV != production
#  - REPROCESS_DISPATCHER=in-process
# Em prod NUNCA defina ALLOW_LOCAL_BYPASS=true.
ALLOW_LOCAL_BYPASS=true
LOCAL_DEV_BYPASS_HEADER=1